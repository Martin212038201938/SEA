# ---------------------------------------------------------------
# SEA-Cockpit – Konfiguration
# Kopieren nach .env und ausfuellen. Nie committen.
# ---------------------------------------------------------------

# Anwendung
COCKPIT_SECRET_KEY=bitte-langen-zufallswert-eintragen
COCKPIT_BASE_URL=https://sea.copilotenschule.de
# Benutzer: name:pbkdf2-hash, mehrere mit ; trennen. Hash erzeugen: python -m cockpit.cli hash-password
COCKPIT_USERS=chris:PBKDF2$...;martin:PBKDF2$...
DATABASE_URL=sqlite:///./data/cockpit.db
TIMEZONE=Europe/Berlin
DEMO_MODE=0

# Geschaeftsparameter (fuer Bewertung und Alerts)
TARGET_CPL_EUR=150
MAX_CPL_EUR=300
AVG_DEAL_VALUE_EUR=5500
CLOSE_RATE=0.4

# Google Ads (Werbekonto Yellow-Boat Consulting)
GOOGLE_ADS_ENABLED=1
GOOGLE_ADS_CUSTOMER_ID=7483422182
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Variante Dienstkonto (empfohlen): JSON-Schluessel des Dienstkontos, das im Ads-Konto als Nutzer eingetragen ist.
# Wenn gesetzt, werden die OAuth-Werte oben ignoriert.
GOOGLE_ADS_SERVICE_ACCOUNT_FILE=/home/y-b/sea-cockpit/data/google-service-account.json
# Seit 09.09.2026 ohne Funktion, die Bibliothek verlangt aber noch einen Wert
GOOGLE_ADS_DEVELOPER_TOKEN=unused

# Microsoft Advertising (Bing) – Kampagnen aktuell pausiert
MS_ADS_ENABLED=0
MS_ADS_DEVELOPER_TOKEN=
MS_ADS_CLIENT_ID=
MS_ADS_CLIENT_SECRET=
MS_ADS_REFRESH_TOKEN=
MS_ADS_CUSTOMER_ID=
MS_ADS_ACCOUNT_ID=

# Trello (Lead-Wahrheit)
TRELLO_ENABLED=0
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
# Listenname -> Status (neu, kontaktiert, angebot, gewonnen, verloren, wiedervorlage, ignorieren). Mapping fuer das Board "Alle Sales Pipelines":
TRELLO_LIST_STATUS_MAP=Downloads:ignorieren;Leads aus Smart Lead Kampagne:neu;Frische Leads aus anderen Quellen:neu;Agent soll Angebot erstellen:angebot;Termin wurde vereinbart:kontaktiert;Po erstellen!:angebot;PO wurde versandt:angebot;PO nachfassen!:angebot;Agent soll nachfassen:angebot;Agentisch nachgefasst:angebot;In Klärung:kontaktiert;Gewonnen:gewonnen;Wurde übergeben an Trainer:gewonnen;Rechnung schicken!:gewonnen;Feedback einholen!:gewonnen;Zahlungseingang checken!:gewonnen;Mahnstufe 1:gewonnen;Erledigt:gewonnen;Rahmenverträge etc:ignorieren;erkaltet. Vielleicht auf Wiedervorlage:wiedervorlage;Verloren:verloren;Im Sommer neu angehen:wiedervorlage;ALTE Opportunities:ignorieren;vereibarungen:ignorieren
# Listenname -> Kanal, wenn die Karte selbst keinen Kanal nennt
TRELLO_LIST_CHANNEL_MAP=Leads aus Smart Lead Kampagne:outbound

# Bookings-Webhook (Power Automate -> POST /api/webhooks/booking)
BOOKINGS_WEBHOOK_SECRET=

# Sprachmodell (Reports, Vorschlaege, Chat): anthropic oder openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Nur noetig, wenn der Schluessel nicht an einen Workspace gebunden ist (Console -> Workspaces -> ID wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_CHEAP=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
OPENAI_MODEL_CHEAP=gpt-6-luna

# Benachrichtigungen
TEAMS_WEBHOOK_URL=
SMTP_HOST=smtp-y-b.alwaysdata.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=sea-cockpit@copilotenschule.de
ALERT_EMAIL_TO=

# MCP-Endpunkt (ChatGPT-Workspace): Pfad /mcp/<MCP_TOKEN>/
MCP_TOKEN=bitte-langen-zufallswert-eintragen
